{
  "manifest_version": 3,
  "name": "SkipTube",
  "version": "1.0.0",
  "description": "A lightweight, privacy-conscious YouTube segment skipper powered by community-submitted SponsorBlock data.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://sponsor.ajay.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "SkipTube", "default_popup": "popup.html" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["content-app.js", "api/*.js", "utils/*.js"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"] }],
  "content_scripts": [{ "matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
